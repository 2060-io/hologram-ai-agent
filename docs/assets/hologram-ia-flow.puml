
@startuml Hologram Agent-IA

title Hologram Agent-IA Message Flow

actor User
participant "CoreService" as CS
participant "ChatbotService" as Chatbot
participant "ApiClient" as API

== Connection Established ==
User -> CS : newConnection(connectionId)
CS -> CS : handleSession()
CS -> CS : sendContextualMenu()

== Profile Received ==
User -> CS : didcomm.user-profile.profile-received
CS -> CS : handleSession()
CS -> CS : update lang
CS -> CS : sendGreetingMessage()
CS -> API : didcomm.sendBasicMessage(greeting)

== Menu Selection ==
User -> CS : didcomm.action-menu.perform-received
CS -> CS : handleContextualAction()
alt Authenticate
    CS -> API : didcomm.createPresentationRequest(jsonSchemaCredentialId | credentialDefinitionId)
    CS -> API : didcomm.sendBasicMessage(AUTH_PROCESS_STARTED)
    CS -> CS : state = AUTH
else Logout
    CS -> CS : isAuthenticated = false
    CS -> CS : purgeUserData()
end

== Basic Message / Presentation Input ==
User -> CS : didcomm.basic-messages.message-received\nor didcomm.presentations.state-updated
CS -> CS : handleStateInput()
alt state == CHAT
    alt needsAuth && !isAuthenticated
        CS -> API : didcomm.sendBasicMessage(AUTH_REQUIRED)
    else
        CS -> Chatbot : chat()
        Chatbot -> CS : answer
        CS -> API : didcomm.sendBasicMessage(answer)
    end
else state == AUTH
    alt presentation done && verified
        CS -> CS : isAuthenticated = true
        CS -> CS : state = CHAT
        CS -> API : didcomm.sendBasicMessage(AUTH_SUCCESS_NAME)
    else
        CS -> API : didcomm.sendBasicMessage(WAITING_CREDENTIAL)
    end
end

== Menu Update ==
CS -> API : didcomm.sendMenu(contextual menu)

@enduml
